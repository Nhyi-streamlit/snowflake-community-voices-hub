GOOGLE_REFRESH_TOKEN = "your-google-oauth2-refresh-token"
GOOGLE_CLIENT_ID = "your-google-oauth2-client-id"
GOOGLE_CLIENT_SECRET = "your-google-oauth2-client-secret"
GOOGLE_SPREADSHEET_ID = "your-new-google-sheet-id"
APP_BASE_URL = "https://your-app-name.streamlit.app"
ADMIN_GOOGLE_SUBJECTS = ["your-verified-google-subject"]

# Notifications stay in the outbox (not sent) until this is true AND a channel is configured below.
DELIVERY_ENABLED = false

[auth]
redirect_uri = "https://your-app-name.streamlit.app/oauth2callback"
cookie_secret = "generate-a-long-random-secret"
client_id = "google-oidc-client-id"
client_secret = "google-oidc-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Workflow store: the dedicated service user from migrations/000_service_identity.sql.template.
# Never use a personal account here. Key-pair auth; keep the key in the host's secret store.
[connections.cv_workflow]
account = "YOUR_ORG-YOUR_ACCOUNT"
user = "CV_WORKFLOW_SVC"
role = "CV_WORKFLOW_APP"
authenticator = "SNOWFLAKE_JWT"
private_key_file = "/secure/runtime/path/to/key.p8"
warehouse = "APP_WAREHOUSE"
database = "APP_DATABASE"
schema = "APP_SCHEMA"

# Email: a shared program mailbox (not a personal one), OAuth client limited to gmail.send.
[notify.gmail]
client_id = "mailbox-oauth-client-id"
client_secret = "mailbox-oauth-client-secret"
refresh_token = "mailbox-refresh-token-gmail-send-only"
sender = "community-voices@snowflake.com"

# Slack DMs for internal owners/delegates only. Bot scopes: chat:write, im:write.
[notify.slack]
bot_token = "xoxb-scoped-bot-token"
